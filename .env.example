# Supabase Configuration for the existing VYBAL project.
# Configure these values in the Secrets panel in AI Studio.
# Never commit actual secret keys or service_role keys to frontend code.
# Only use your project URL and public anon key in the Android client.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
